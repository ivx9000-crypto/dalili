# Dalili frontend production environment
# Copy these into Vercel/Netlify environment variables.

# Public URL of the deployed FastAPI backend. Do not include a trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://your-dalili-api.onrender.com

# Backwards-compatible alias used by older components.
NEXT_PUBLIC_API_BASE=https://your-dalili-api.onrender.com

# Production safety
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
