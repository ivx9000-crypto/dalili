# Dalili backend environment variables for Render/Railway/DigitalOcean App Platform
APP_ENV=production
APP_NAME=Dalili API

# Use your managed PostgreSQL external URL.
# Render often provides postgres://; for SQLAlchemy use postgresql+psycopg2://
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# Production should use Alembic migrations, not automatic table creation.
AUTO_CREATE_TABLES=false

# Only allow your deployed frontend domains.
CORS_ORIGINS=https://your-dalili-app.vercel.app,https://yourdomain.com

# Public API URL and frontend URL.
PUBLIC_BASE_URL=https://your-dalili-api.onrender.com
FRONTEND_BASE_URL=https://your-dalili-app.vercel.app

# Local server file storage path; move to object storage before scaling.
UPLOAD_STORAGE_DIR=app/storage/uploads
MAX_UPLOAD_MB=50

# Before public launch replace local_dev_token with email-based reset mode.
PASSWORD_RESET_MODE=production_email_required
DEMO_MODE=false
