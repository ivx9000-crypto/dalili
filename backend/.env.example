# Dalili backend development configuration
APP_NAME=Dalili API
APP_ENV=development

# Default local development database. For PostgreSQL local testing, use:
# DATABASE_URL=postgresql+psycopg2://dalili_user:dalili_password@localhost:5432/dalili
DATABASE_URL=sqlite:///./dalili_dev.db

# Keep true for local SQLite convenience. Set false when using Alembic migrations.
AUTO_CREATE_TABLES=true

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://localhost:3000
UPLOAD_STORAGE_DIR=app/storage/uploads
MAX_UPLOAD_MB=50
PASSWORD_RESET_MODE=local_dev_token
