APP_ENV=production
APP_NAME=Dalili API
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE
AUTO_CREATE_TABLES=false
CORS_ORIGINS=https://YOUR-VERCEL-FRONTEND.vercel.app,https://YOUR-CUSTOM-DOMAIN.com
PUBLIC_BASE_URL=https://YOUR-RENDER-BACKEND.onrender.com
FRONTEND_BASE_URL=https://YOUR-VERCEL-FRONTEND.vercel.app
UPLOAD_STORAGE_DIR=app/storage/uploads
MAX_UPLOAD_MB=50
PASSWORD_RESET_MODE=production_email_required
DEMO_MODE=false
